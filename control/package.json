{
  "name": "tule-control",
  "private": true,
  "description": "Tule's control plane: a Worker with one Project Durable Object per project, which owns the project's machine; see DESIGN.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ../web/build.mjs --watch & wrangler dev --port 8787 --ip 127.0.0.1 --local-upstream 127.0.0.1:8787; kill %1",
    "deploy": "npm --prefix ../web run build && wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4"
  }
}
