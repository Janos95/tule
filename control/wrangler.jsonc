{
  // Tule's control plane (see DESIGN.md): the viewer's static files, the CLI
  // API and the tunnel endpoints, one Project Durable Object per project that
  // owns the project's machine (a Cloudflare Container it starts per run).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tule",
  "main": "src/index.ts",
  // web/src/palette.css is imported by pages.ts as text
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [{ "pattern": "tule.janosmeny.com", "custom_domain": true }],
  // skills/*.md -> src/skills.gen.ts (the MCP server's guide tool)
  "build": { "command": "node gen-skills.mjs" },
  // web/dist (npm --prefix ../web run build): the viewer, /p/<project>. The
  // Worker runs first for every path (sign-in, pages, API) and serves the rest.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // PUBLIC_URL: this deployment's origin (OAuth issuer and MCP resource).
  // ALLOWED_EMAILS: who may sign up ("*" for anyone). CPU_HOURS_MONTH: each
  // user's CPU machine time. Secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // ENCRYPTION_KEY (32 bytes, base64; encrypts stored RunPod keys), DEV_TOKEN.
  "vars": {
    "PUBLIC_URL": "https://tule.janosmeny.com",
    "ALLOWED_EMAILS": "janos.meny@googlemail.com",
    "CPU_HOURS_MONTH": "100",
    // guests (no sign-in): projects each, machine minutes a day each, guest
    // machines running at once site-wide, days kept after the last visit
    "GUEST_PROJECTS": "1",
    "GUEST_MINUTES_DAY": "30",
    "GUEST_MACHINES": "2",
    "GUEST_DAYS": "1",
    // GPU machines run this image on RunPod (built by .github/workflows/runtime.yml)
    "GPU_IMAGE": "ghcr.io/janos95/tule-runtime:cuda"
  },
  // the machine image: Durable Object scheduling, so each start picks its
  // instance size (cpu-1 .. cpu-4) and passes its own join token
  "containers": [
    {
      "class_name": "Project",
      "scheduling_policy": "durable_object",
      "images": { "cpu": { "dockerfile": "../runtime/Dockerfile", "build_context": ".." } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "Project" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "HOST", "class_name": "Host" }
    ]
  },
  // the OAuth provider's grants and tokens (hashed) for MCP clients
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4ce03178f1514f2486405f903c68b9c2" }],
  // workspace snapshots: content-addressed chunks and manifests per project
  "r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "tule-workspaces" }],
  "exports": {
    "Project": { "type": "durable-object", "storage": "sqlite" },
    "Accounts": { "type": "durable-object", "storage": "sqlite" },
    "Host": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
