# The GPU machine image for RunPod pods (see DESIGN.md, "Pluggable backends"): the CPU
# image's stack (runtime/Dockerfile; keep them in step) on CUDA 12, plus CuPy and SciPy.
# Build context: the repository root.
#   docker build --platform linux/amd64 -f runtime/Dockerfile.cuda -t tule-runtime:cuda .
# The pod's environment carries TULE_URL, TULE_PROJECT and TULE_JOIN_TOKEN; tule-agent
# dials out with them and runs sshd on 127.0.0.1 only (no ports to expose).
# CUDA 12.6 runs on drivers >= 560, and on >= 525 through CUDA's minor version compatibility.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server git ca-certificates libgl1 libx11-6 \
 && dpkg-query -W -f '${Package}\n' | grep -E '^(mesa-libgallium|libgallium.*|libgl1-mesa-dri|libglx-mesa0|libllvm[0-9]+|libz3-4)$' \
    | xargs -r dpkg --remove --force-depends \
 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
# (OCP only needs libGL.so.1 to load; the Mesa drivers are for rendering)

# Python 3.13: a relocatable standalone build (via uv) in /usr/local, as in the CPU image,
# so python, pip and console scripts are on every SSH session's PATH
RUN --mount=from=ghcr.io/astral-sh/uv:0.9.0,source=/uv,target=/bin/uv \
    UV_PYTHON_INSTALL_DIR=/tmp/py uv python install 3.13 \
 && cp -a /tmp/py/cpython-3.13*/. /usr/local/ && rm -rf /tmp/py \
 && rm -f /usr/local/lib/python3.13/EXTERNALLY-MANAGED \
 && ln -sf python3 /usr/local/bin/python \
 && python -m ensurepip --upgrade --default-pip && python -m pip install --no-cache-dir --upgrade pip \
 && python --version

# OCP links against VTK libraries at import (vtk is its only heavy dependency)
COPY runtime/prune_vtk.sh /tmp/prune_vtk.sh
RUN pip install --no-cache-dir cadquery-ocp==8.0.1.1.0 numpy scipy scikit-image pillow==11.3.0 websockets==17.4 pytest cupy-cuda12x \
 && sh /tmp/prune_vtk.sh && rm /tmp/prune_vtk.sh

COPY python /opt/tule/python
RUN pip install --no-cache-dir --no-deps /opt/tule/python
RUN --mount=type=bind,source=cli,target=/tmp/cli,rw pip install --no-cache-dir --no-deps /tmp/cli
COPY skills /opt/tule/skills
COPY templates/project /opt/tule/template
COPY runtime/tule_agent.py runtime/workspace.py runtime/local.py runtime/files.py runtime/annotations.py /opt/tule/
RUN git config --system init.defaultBranch main \
 && git config --system user.name "Tule agent" && git config --system user.email "agent@tule.local"

ENV TULE_WORKSPACE=/workspace PYTHONUNBUFFERED=1
WORKDIR /workspace
ENTRYPOINT ["python", "/opt/tule/tule_agent.py"]
