# The GPU machine image for RunPod pods (see DESIGN.md, "Pluggable backends"): the CPU
# image's stack (runtime/Dockerfile; keep them in step) on CUDA 12, plus CuPy and SciPy.
# Build context: the repository root.
#   docker build --platform linux/amd64 -f runtime/Dockerfile.cuda -t tule-runtime:cuda .
# The pod's environment carries TULE_URL, TULE_PROJECT and TULE_JOIN_TOKEN; tule-agent
# dials out with them and runs sshd on 127.0.0.1 only (no ports to expose).
# CUDA 12.6 runs on drivers >= 560, and on >= 525 through CUDA's minor version compatibility.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server git git-lfs ca-certificates libgl1 libx11-6 ripgrep patch jq curl wget fonts-dejavu-core poppler-utils tini \
 && dpkg-query -W -f '${Package}\n' | grep -E '^(mesa-libgallium|libgallium.*|libgl1-mesa-dri|libglx-mesa0|libllvm[0-9]+|libz3-4)$' \
    | while read -r p; do dpkg -L $p | while read -r f; do if [ -f "$f" ]; then rm -f "$f"; fi; done; done \
 && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
# datasheet sites often refuse curl's and wget's own names (403): they ask as a browser would
RUN printf 'user-agent = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36"\nlocation\n' > /root/.curlrc \
 && printf 'user_agent = Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36\n' >> /etc/wgetrc
# (OCP only needs libGL.so.1 to load; the Mesa drivers are for rendering. Their files go but the packages
# stay installed, so apt keeps working)

# Python 3.13: a relocatable standalone build (via uv) in /usr/local, as in the CPU image,
# so python, pip and console scripts are on every SSH session's PATH
RUN --mount=from=ghcr.io/astral-sh/uv:0.9.0,source=/uv,target=/bin/uv \
    UV_PYTHON_INSTALL_DIR=/tmp/py uv python install 3.13 \
 && cp -a /tmp/py/cpython-3.13*/. /usr/local/ && rm -rf /tmp/py \
 && rm -f /usr/local/lib/python3.13/EXTERNALLY-MANAGED \
 && ln -sf python3 /usr/local/bin/python \
 && python -m ensurepip --upgrade --default-pip && python -m pip install --no-cache-dir --upgrade pip \
 && python --version

# OCP links against VTK libraries at import (vtk is its only heavy dependency)
COPY runtime/prune_vtk.sh /tmp/prune_vtk.sh
RUN pip install --no-cache-dir cadquery-ocp==8.0.1.1.0 numpy scipy scikit-image pillow==11.3.0 websockets==17.4 pytest requests beautifulsoup4 trimesh lxml networkx pymupdf ezdxf python-fcl "cupy-cuda12x[ctk]" \
 && sh /tmp/prune_vtk.sh && rm /tmp/prune_vtk.sh

COPY python /opt/tule/python
RUN pip install --no-cache-dir --no-deps /opt/tule/python \
 && echo /workspace > "$(python -c 'import site; print(site.getsitepackages()[0])')/workspace.pth"
RUN --mount=type=bind,source=cli,target=/tmp/cli,rw pip install --no-cache-dir --no-deps /tmp/cli
COPY skills /opt/tule/skills
COPY templates/project /opt/tule/template
COPY runtime/tule_agent.py runtime/workspace.py runtime/saves.py runtime/local.py runtime/files.py runtime/annotations.py /opt/tule/
# git: saves go to the project's Tule remote (git-remote-tule, from the CLI); big
# files through Git LFS, with the pre-commit hook moving any it missed there
COPY runtime/git-hooks /opt/tule/git-hooks
RUN git config --system init.defaultBranch main \
 && git config --system user.name "Tule agent" && git config --system user.email "agent@tule.local" \
 && git lfs install --system --skip-repo \
 && git config --system core.hooksPath /opt/tule/git-hooks \
 && git config --system lfs.locksverify false \
 && git config --system --add credential.helper "" && git config --system --add credential.helper tule \
 && printf '# SSH sessions and commands start in the project\n[ "$PWD" = "$HOME" ] && [ -d /workspace ] && cd /workspace\n' | cat - /root/.bashrc > /tmp/rc && mv /tmp/rc /root/.bashrc

ENV TULE_WORKSPACE=/workspace PYTHONUNBUFFERED=1
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "python", "/opt/tule/tule_agent.py"]
